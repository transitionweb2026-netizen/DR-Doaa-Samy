# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# If these are left unset, the site falls back to the local data/*.ts files
# and renders exactly as it did before the CMS existed — nothing breaks.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER exposed to the browser. Bypasses RLS entirely; used
# only by the seed script and other trusted server-side tooling.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
